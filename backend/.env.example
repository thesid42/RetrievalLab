RETRIEVALLAB_ENVIRONMENT=development
RETRIEVALLAB_DEMO_MODE=false
# Set true only to demonstrate deliberately injected baseline retrieval failures.
RETRIEVALLAB_CORS_ORIGINS=http://localhost:5173
# Set this for any shared/public deployment; clients send it as X-API-Key.
RETRIEVALLAB_API_ACCESS_KEY=

# A relative path is resolved from the repository root. Use a new filename for a fresh demo.
RETRIEVALLAB_STATE_PATH=runtime/retrievallab.db

# Each URL points at a thin deployment-specific bridge. Leave blank to use the
# explicit local fallback while sponsor credentials and exact APIs are configured.
RETRIEVALLAB_COGNEE_BASE_URL=
RETRIEVALLAB_COGNEE_API_KEY=
RETRIEVALLAB_HYDRADB_BASE_URL=
RETRIEVALLAB_HYDRADB_API_KEY=
RETRIEVALLAB_HOTDATA_BASE_URL=
RETRIEVALLAB_HOTDATA_API_KEY=
RETRIEVALLAB_ROCKETRIDE_BASE_URL=
RETRIEVALLAB_ROCKETRIDE_API_KEY=
RETRIEVALLAB_ROTE_BASE_URL=
RETRIEVALLAB_ROTE_API_KEY=
