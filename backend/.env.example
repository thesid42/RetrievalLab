RETRIEVALLAB_ENVIRONMENT=development
RETRIEVALLAB_DEMO_MODE=false
# Set true only to demonstrate deliberately injected baseline retrieval failures.
RETRIEVALLAB_CORS_ORIGINS=http://localhost:5173
# Set this for any shared/public deployment; clients send it as X-API-Key.
RETRIEVALLAB_API_ACCESS_KEY=

# A relative path is resolved from the repository root. Use a new filename for a fresh demo.
RETRIEVALLAB_STATE_PATH=runtime/retrievallab.db

# Native providers. Secrets stay in this backend file, never web/.env.
# Shared API hosts already have defaults; they are NOT dashboard URLs.
# Blank credentials keep explicit local fallback active. See INTEGRATIONS.md.

# Hotdata: workspace/database IDs come from your own provisioned resources.
RETRIEVALLAB_HOTDATA_API_URL=https://api.hotdata.dev
RETRIEVALLAB_HOTDATA_API_KEY=
RETRIEVALLAB_HOTDATA_WORKSPACE_ID=
RETRIEVALLAB_HOTDATA_DATABASE_ID=
RETRIEVALLAB_HOTDATA_TABLE=default.main.retrieval_documents
# Optional existing writable telemetry table; blank retains SQLite telemetry only.
RETRIEVALLAB_HOTDATA_TELEMETRY_TABLE=

# Cognee Cloud: tenant Connection Details URL and X-Api-Key.
# Self-hosted authenticated API: set auth mode to bearer and provide a session token.
RETRIEVALLAB_COGNEE_API_URL=
RETRIEVALLAB_COGNEE_API_KEY=
RETRIEVALLAB_COGNEE_AUTH_MODE=api_key
RETRIEVALLAB_COGNEE_DATASET=retrievallab

# HydraDB native tenant-scoped memory API (no Cypher bridge).
RETRIEVALLAB_HYDRADB_API_URL=https://api.hydradb.com
RETRIEVALLAB_HYDRADB_API_KEY=
RETRIEVALLAB_HYDRADB_TENANT_ID=
RETRIEVALLAB_HYDRADB_SUB_TENANT_ID=

# RocketRide: native SDK, reviewed pipeline file and its input source node ID.
RETRIEVALLAB_ROCKETRIDE_URI=https://api.rocketride.ai
RETRIEVALLAB_ROCKETRIDE_API_KEY=
RETRIEVALLAB_ROCKETRIDE_PIPELINE_PATH=
RETRIEVALLAB_ROCKETRIDE_SOURCE_ID=

# Rote: CLI installed/authenticated separately, plus a reviewed approved Play.
# Configuring a Play opts into executing it; never use an unreviewed remote Play.
RETRIEVALLAB_ROTE_CLI_PATH=rote
RETRIEVALLAB_ROTE_PLAY_REF=
RETRIEVALLAB_ROTE_TIMEOUT_SECONDS=30

# Snyk is a development scan CLI, not an app runtime provider.
# Run `snyk auth` or supply SNYK_TOKEN in your shell/CI; no base URL is needed.
